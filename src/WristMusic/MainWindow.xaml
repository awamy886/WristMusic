<Window x:Class="WristMusic.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WristMusic" xmlns:views="clr-namespace:WristMusic.Views" Title="腕间音乐 · SteamVR 音乐控制" Width="1360" Height="870" MinWidth="1120" MinHeight="780" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource Theme.Canvas}" Foreground="{DynamicResource Legacy.F3F1FA.Brush}">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" /></WindowChrome.WindowChrome>
  <Window.Resources>
    <local:PageConverter x:Key="PageConverter" />
    <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Legacy.A3A1B5.Brush}" /><Setter Property="FontSize" Value="14" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,4" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Frame" CornerRadius="10" Padding="17,17" Background="Transparent"><Grid><Border x:Name="Stripe" Background="{DynamicResource Legacy.B79AFF.Brush}" Width="3" Height="22" HorizontalAlignment="Left" Margin="-17,0,0,0" Visibility="Collapsed" /><ContentPresenter /></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Legacy.2B253D.Brush}" /><Setter TargetName="Stripe" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="{DynamicResource Legacy.D6C4FF.Brush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource Legacy.24212E.Brush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Legacy.B79AFF.Brush}" /><Setter TargetName="Frame" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource Legacy.2B2B37.Brush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Theme.Canvas}" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13">
    <Grid><Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.ColumnSpan="2" Background="{DynamicResource Theme.Header}" BorderBrush="{DynamicResource Legacy.272732.Brush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag"><Grid Margin="26,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="142" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0"><Border Width="4" Height="12" Background="{DynamicResource Legacy.9974DD.Brush}" CornerRadius="2" Margin="0,0,4,0" /><Border Width="4" Height="30" Background="{DynamicResource Legacy.BFA4FA.Brush}" CornerRadius="2" Margin="0,0,4,0" /><Border Width="4" Height="42" Background="{DynamicResource Legacy.A17DE8.Brush}" CornerRadius="2" Margin="0,0,4,0" /><Border Width="4" Height="23" Background="{DynamicResource Legacy.C5ACFF.Brush}" CornerRadius="2" Margin="0,0,4,0" /><Border Width="4" Height="12" Background="{DynamicResource Legacy.9974DD.Brush}" CornerRadius="2" /></StackPanel><StackPanel><TextBlock Text="腕间音乐" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="MUSIC WITHIN REACH" FontSize="8" Foreground="{DynamicResource Legacy.858093.Brush}" Margin="0,3,0,0" /></StackPanel></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Legacy.1D2029.Brush}" CornerRadius="16" Padding="12,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding VrDot}" Width="7" Height="7" Margin="0,0,7,0" /><TextBlock Text="{Binding VrStatus}" FontSize="11" Foreground="{DynamicResource Legacy.C6C1D2.Brush}" /></StackPanel></Border><Border Background="{DynamicResource Legacy.1D2029.Brush}" CornerRadius="16" Padding="12,8"><TextBlock Text="{Binding VrChatLabel}" FontSize="11" Foreground="{DynamicResource Legacy.A8A2B7.Brush}" /></Border></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="&#xE921;" Style="{StaticResource IconButton}" Width="38" Height="34" FontSize="12" Background="Transparent" BorderThickness="0" Click="MinimizeClick" ToolTip="最小化" /><Button Content="&#xE922;" Style="{StaticResource IconButton}" Width="38" Height="34" FontSize="12" Background="Transparent" BorderThickness="0" Click="MaximizeClick" ToolTip="最大化 / 还原" /><Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="38" Height="34" FontSize="12" Background="Transparent" BorderThickness="0" Click="CloseClick" ToolTip="退出" /></StackPanel>
      </Grid></Border>
      <Border Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Theme.Sidebar}" BorderBrush="{DynamicResource Legacy.252530.Brush}" BorderThickness="0,0,1,0"><DockPanel Margin="12,22,12,20"><StackPanel DockPanel.Dock="Bottom" Margin="13,0"><TextBlock Text="v3.0.0 · 星梦屿工作室" FontSize="9" Foreground="{DynamicResource Legacy.5B576A.Brush}" Margin="0,8,0,0" /></StackPanel><StackPanel>
        <TextBlock Text="你的空间" FontSize="10" Foreground="{DynamicResource Legacy.686477.Brush}" Margin="17,0,0,12" />
        <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=player}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,13,0" /><TextBlock Text="正在播放" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
        <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=apps}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,13,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="应用管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
        <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=wrist}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF4BF;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,13,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="手腕面板" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
        <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=hotkeys}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,13,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="快捷键" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
        <RadioButton Style="{StaticResource Nav}" IsChecked="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=settings}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,13,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
        <Border Height="1" Background="{DynamicResource Legacy.252530.Brush}" Margin="17,20" /><TextBlock Text="支持你熟悉的播放器" Foreground="{DynamicResource Legacy.6E697E.Brush}" FontSize="10" Margin="17,0,0,12" /><StackPanel Orientation="Horizontal" Margin="17,0"><TextBlock Text="云" Foreground="{DynamicResource Legacy.E45D71.Brush}" FontWeight="Bold" Margin="0,0,17,0" /><TextBlock Text="Q" Foreground="{DynamicResource Legacy.46CCA1.Brush}" FontWeight="Bold" Margin="0,0,17,0" /><TextBlock Text="K" Foreground="{DynamicResource Legacy.5EA8F2.Brush}" FontWeight="Bold" Margin="0,0,17,0" /><TextBlock Text="汽" Foreground="{DynamicResource Legacy.D0DB70.Brush}" FontWeight="Bold" /></StackPanel>
      </StackPanel></DockPanel></Border>
      <Grid Grid.Row="1" Grid.Column="1" Margin="28,27,28,18"><Grid.RowDefinitions><RowDefinition Height="77" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding PageSubtitle}" Foreground="{DynamicResource Legacy.858095.Brush}" FontSize="12" Margin="0,9,0,0" /></StackPanel>
        <views:PlayerPage Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=player}" />
        <views:AppsPage Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=apps}" />
        <views:WristPage Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=wrist}" />
        <views:HotkeysPage Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=hotkeys}" />
        <views:SettingsPage Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource PageConverter}, ConverterParameter=settings}" />
      </Grid>
      <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource Legacy.252530.Brush}" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel LastChildFill="True"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Legacy.B4A9C7.Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></Border>
    </Grid>
  </Border>
</Window>
