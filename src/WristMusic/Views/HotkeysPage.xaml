<UserControl x:Class="WristMusic.Views.HotkeysPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="桌面全局快捷键" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><CheckBox Content="启用快捷键" IsChecked="{Binding Hotkeys}" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="程序运行时可在其他窗口中使用；快捷键仍遵循当前选择的音乐来源。" Foreground="{DynamicResource Legacy.887C9B.Brush}" FontSize="12" Margin="0,8,0,30" />
    <Border Background="{DynamicResource Legacy.22202D.Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><DockPanel><TextBlock Text="播放 / 暂停" FontSize="14" /><TextBlock Text="Ctrl  +  Alt  +  Space" Foreground="{DynamicResource Legacy.B79AFF.Brush}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel></Border><Border Background="{DynamicResource Legacy.22202D.Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><DockPanel><TextBlock Text="上一首" FontSize="14" /><TextBlock Text="Ctrl  +  Alt  +  ←" Foreground="{DynamicResource Legacy.B79AFF.Brush}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel></Border><Border Background="{DynamicResource Legacy.22202D.Brush}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><DockPanel><TextBlock Text="下一首" FontSize="14" /><TextBlock Text="Ctrl  +  Alt  +  →" Foreground="{DynamicResource Legacy.B79AFF.Brush}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel></Border><Border Background="{DynamicResource Legacy.22202D.Brush}" CornerRadius="12" Padding="20"><DockPanel><TextBlock Text="显示 / 隐藏手腕面板" FontSize="14" /><TextBlock Text="Ctrl  +  Alt  +  O" Foreground="{DynamicResource Legacy.B79AFF.Brush}" HorizontalAlignment="Right" FontFamily="Consolas" /></DockPanel></Border>
    <TextBlock Text="手柄操作" FontSize="17" Margin="0,32,0,12" /><TextBlock Text="佩戴侧手柄负责定位。另一只手柄负责瞄准；扳机点击按钮、点击进度条，或按住调整音量。&#x0a;面板随佩戴侧手柄移动，实际位置可在「手腕面板」中校准。" Foreground="{DynamicResource Legacy.92849F.Brush}" FontSize="13" TextWrapping="Wrap" LineHeight="25" /><TextBlock Text="若快捷键已被其他软件占用，底部状态栏会提示注册失败。" Foreground="{DynamicResource Legacy.6E627D.Brush}" FontSize="11" Margin="0,24,0,0" />
  </StackPanel></Border>
</UserControl>
