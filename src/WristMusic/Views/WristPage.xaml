<UserControl x:Class="WristMusic.Views.WristPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WristMusic.Views">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /><RowDefinition Height="60" /></Grid.RowDefinitions><TextBlock Text="实时面板预览" FontSize="15" /><Viewbox Grid.Row="1" Margin="0,14" IsHitTestVisible="False"><views:OverlayView /></Viewbox><StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="{Binding VrStatus}" Foreground="{DynamicResource Legacy.C0A4F1.Brush}" FontSize="13" /><TextBlock Text="{Binding VrDetail}" Foreground="{DynamicResource Legacy.83798F.Brush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20"><StackPanel><TextBlock Text="从手腕开始，留在此刻" FontSize="15" /><TextBlock Text="① 以 SteamVR 模式启动 VRChat。&#x0a;② 双击 B 显示 / 隐藏面板；抬腕显示默认关闭。&#x0a;③ 用另一只手柄瞄准，看到光点后按扳机。&#x0a;④ 点击进度条跳转；按住扳机滑动调整系统音量。" Foreground="{DynamicResource Legacy.968AA8.Brush}" FontSize="12" LineHeight="26" Margin="0,10,0,0" /></StackPanel></Border></Grid>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22"><ScrollViewer Style="{StaticResource AppScrollViewer}" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="佩戴与显示" FontSize="16" FontWeight="SemiBold" /><CheckBox Content="启用手腕面板" IsChecked="{Binding OverlayEnabled}" /><CheckBox Content="双击 B 显示 / 隐藏 VR 面板" IsChecked="{Binding DoubleBToOpen}" /><CheckBox Content="仅在抬腕时显示" IsChecked="{Binding RaiseToShow}" /><Grid Margin="0,8,0,20"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions><Button Content="佩戴左手" Command="{Binding WristCommand}" CommandParameter="left" /><Button Grid.Column="2" Content="佩戴右手" Command="{Binding WristCommand}" CommandParameter="right" /></Grid><TextBlock Text="{Binding WristLabel, StringFormat=当前佩戴：{0}}" Foreground="{DynamicResource Legacy.B79AFF.Brush}" FontSize="11" Margin="0,-10,0,18" />
      <TextBlock Text="{Binding Scale, StringFormat=面板大小   {0:0}%}" Foreground="{DynamicResource Legacy.B4A5C7.Brush}" FontSize="12" /><Slider Minimum="50" Maximum="160" Value="{Binding Scale, Mode=TwoWay}" Margin="-7,5,-7,10" /><TextBlock Text="{Binding Opacity, StringFormat=不透明度   {0:0}%}" Foreground="{DynamicResource Legacy.B4A5C7.Brush}" FontSize="12" /><Slider Minimum="30" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}" Margin="-7,5,-7,10" /><Border Height="1" Background="{DynamicResource Legacy.33303D.Brush}" Margin="0,8,0,18" />
      <TextBlock Text="位置微调" FontSize="14" /><TextBlock Text="不同手柄的握持角度不同，可在 VR 内观察并调整。" Foreground="{DynamicResource Legacy.766B87.Brush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,15" />
      <TextBlock Text="{Binding OffsetX, StringFormat=水平偏移   {0:0} cm}" Foreground="{DynamicResource Legacy.B4A5C7.Brush}" FontSize="11" /><Slider Minimum="-30" Maximum="30" Value="{Binding OffsetX, Mode=TwoWay}" Margin="-7,2,-7,7" /><TextBlock Text="{Binding OffsetY, StringFormat=高度偏移   {0:0} cm}" Foreground="{DynamicResource Legacy.B4A5C7.Brush}" FontSize="11" /><Slider Minimum="-30" Maximum="30" Value="{Binding OffsetY, Mode=TwoWay}" Margin="-7,2,-7,7" /><TextBlock Text="{Binding OffsetZ, StringFormat=前后偏移   {0:0} cm}" Foreground="{DynamicResource Legacy.B4A5C7.Brush}" FontSize="11" /><Slider Minimum="-30" Maximum="30" Value="{Binding OffsetZ, Mode=TwoWay}" Margin="-7,2,-7,7" /><TextBlock Text="{Binding Tilt, StringFormat=面板倾角   {0:0}°}" Foreground="{DynamicResource Legacy.B4A5C7.Brush}" FontSize="11" /><Slider Minimum="-180" Maximum="180" Value="{Binding Tilt, Mode=TwoWay}" Margin="-7,2,-7,15" /><Button Content="恢复默认位置" Command="{Binding ResetCommand}" Margin="0,0,0,12" /><Button Content="重新连接 SteamVR" Command="{Binding ReconnectCommand}" Background="{DynamicResource Legacy.45345F.Brush}" BorderBrush="{DynamicResource Legacy.6D528F.Brush}" /></StackPanel></ScrollViewer></Border>
  </Grid>
</UserControl>
