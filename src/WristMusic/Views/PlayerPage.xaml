<UserControl x:Class="WristMusic.Views.PlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WristMusic.Views">
  <Grid>
    <views:LightPlayerPage><views:LightPlayerPage.Style><Style TargetType="views:LightPlayerPage"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding DarkMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></views:LightPlayerPage.Style></views:LightPlayerPage>
    <views:DarkPlayerPage><views:DarkPlayerPage.Style><Style TargetType="views:DarkPlayerPage"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DarkMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></views:DarkPlayerPage.Style></views:DarkPlayerPage>
  </Grid>
</UserControl>
