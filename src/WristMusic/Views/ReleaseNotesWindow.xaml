<Window x:Class="WristMusic.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="腕间音乐 · 更新公告" Icon="/Assets/app.ico" Width="448" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Theme.Surface}" Foreground="{DynamicResource Theme.Text}"
        FontFamily="Microsoft YaHei UI">
  <StackPanel Margin="28,24">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18" />
    <Border Padding="16,10" CornerRadius="10" Background="{DynamicResource Theme.SurfaceSoft}">
      <StackPanel>
        <StackPanel.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6" />
          </Style>
        </StackPanel.Resources>
        <TextBlock Text="1. 设置里加入了自动更新功能" />
        <TextBlock Text="2. 修复了酷狗音乐无法正常识别播放" />
        <TextBlock Text="3. 网页端浏览器音乐识别导致错误Bug问题" />
        <TextBlock Text="4. 增加了更新公告弹窗" />
        <TextBlock Text="5. 音乐支持 Spotify" />
      </StackPanel>
    </Border>
    <Button Content="知道了" Click="Dismiss" IsDefault="True" HorizontalAlignment="Right"
            Padding="20,8" Margin="0,20,0,0" />
  </StackPanel>
</Window>
