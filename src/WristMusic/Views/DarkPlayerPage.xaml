<UserControl x:Class="WristMusic.Views.DarkPlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WristMusic.Views">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="26"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="58" /><RowDefinition Height="103" /><RowDefinition Height="65" /><RowDefinition Height="53" /><RowDefinition Height="28" /></Grid.RowDefinitions>
      <Grid><TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Legacy.9485AB.Brush}" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" HorizontalAlignment="Right" Width="176" FontSize="11" Height="31" ToolTip="选择需要控制的音乐来源" /></Grid>
      <Grid Grid.Row="1" Margin="0,18,0,10" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="170" Height="170" HorizontalAlignment="Left" CornerRadius="16" BorderBrush="{DynamicResource Legacy.514564.Brush}" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.35" /></Border.Effect><Image Source="{Binding Artwork}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="31" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Artist}" Foreground="{DynamicResource Legacy.A49AAF.Brush}" FontSize="16" Margin="0,10,0,16" TextTrimming="CharacterEllipsis" /><Border Background="{DynamicResource Legacy.282432.Brush}" CornerRadius="14" Padding="11,6" HorizontalAlignment="Left" MaxWidth="240"><TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{DynamicResource Legacy.C6B6DE.Brush}" TextTrimming="CharacterEllipsis" /></Border><TextBlock Text="{Binding ModeLabel}" FontSize="10" Foreground="{DynamicResource Legacy.736D84.Brush}" Margin="0,12,0,0" /></StackPanel></Grid>
      <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions><Slider x:Name="Progress" Value="{Binding SeekPosition, Mode=TwoWay}" Minimum="{Binding TimelineMin}" Maximum="{Binding Duration}" IsEnabled="{Binding CanSeek}" ToolTip="拖动调整播放进度" /><TextBlock Grid.Row="1" Text="{Binding PositionLabel}" FontSize="10" Foreground="{DynamicResource Legacy.8F859F.Brush}" Margin="7,3,0,0" /><TextBlock Grid.Row="1" Text="{Binding DurationLabel}" FontSize="10" Foreground="{DynamicResource Legacy.8F859F.Brush}" HorizontalAlignment="Right" Margin="0,3,7,0" /></Grid>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding MediaCommand}" CommandParameter="previous" ToolTip="上一首" Width="58" Height="58" Margin="0,0,24,0" /><Button Content="{Binding PlayGlyph}" Command="{Binding MediaCommand}" CommandParameter="toggle" ToolTip="{Binding PlayLabel}" Width="80" Height="80" Background="{DynamicResource Legacy.B79AFF.Brush}" Foreground="{DynamicResource Legacy.20162E.Brush}" BorderBrush="{DynamicResource Legacy.CDB7FF.Brush}" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="31"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Disc" CornerRadius="40" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="{DynamicResource Legacy.CBB3FF.Brush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Disc" Property="Opacity" Value="0.3" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="BorderBrush" Value="White" /><Setter TargetName="Disc" Property="BorderThickness" Value="3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button><Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding MediaCommand}" CommandParameter="next" ToolTip="下一首" Width="58" Height="58" Margin="24,0,0,0" /></StackPanel>
      <Border Grid.Row="4" BorderBrush="{DynamicResource Legacy.30303D.Brush}" BorderThickness="0,1,0,1" Margin="0,4,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,0,10,0" Foreground="{DynamicResource Legacy.B5ABC7.Brush}" /><TextBlock Text="系统音量" FontSize="12" Foreground="{DynamicResource Legacy.A79BB8.Brush}" /></StackPanel><Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding CanVolume}" ToolTip="Windows 默认输出设备的主音量" /><TextBlock Grid.Column="2" Text="{Binding VolumeLabel}" FontSize="11" Foreground="{DynamicResource Legacy.AA9BBF.Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
      <Grid Grid.Row="5" Margin="0,3,0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><Button Command="{Binding OpenCommand}" Background="{DynamicResource Legacy.45345F.Brush}" BorderBrush="{DynamicResource Legacy.6D528F.Brush}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="打开音乐软件" /></StackPanel></Button><Button Grid.Column="2" Command="{Binding CloseCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="关闭音乐软件" /></StackPanel></Button></Grid>
      <DockPanel Grid.Row="6" VerticalAlignment="Bottom"><TextBlock DockPanel.Dock="Right" Text="{Binding ListeningTimeLabel}" Visibility="{Binding ListeningTimeVisible, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Theme.Accent}" FontSize="10" Margin="12,0,0,0" /><TextBlock Text="{Binding CapabilityLabel}" Foreground="{DynamicResource Legacy.7D748D.Brush}" FontSize="9" TextTrimming="CharacterEllipsis" /></DockPanel>
    </Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="33" /><RowDefinition Height="205" /><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions><Grid><TextBlock Text="你的 VR 面板" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="PREVIEW" Foreground="{DynamicResource Legacy.7E728F.Brush}" FontSize="8" HorizontalAlignment="Right" Margin="0,7,0,0" /></Grid>
      <Border Grid.Row="1" CornerRadius="12" BorderBrush="{DynamicResource Legacy.34303F.Brush}" BorderThickness="1" ClipToBounds="True"><Border.Background><RadialGradientBrush Center="0.6,0.3" RadiusX="0.9" RadiusY="0.9"><GradientStop Color="{DynamicResource Legacy.3C2F54.Color}" /><GradientStop Color="{DynamicResource Legacy.13141D.Color}" Offset="1" /></RadialGradientBrush></Border.Background><Grid><Path Data="M-40,166 C70,154 90,164 150,149 S250,132 320,175 L330,214 H-40Z" Fill="{DynamicResource Legacy.38343F.Brush}" Stroke="{DynamicResource Legacy.554A65.Brush}" StrokeThickness="1" VerticalAlignment="Bottom" /><Viewbox Margin="9,16,9,24" IsHitTestVisible="False"><views:OverlayView><views:OverlayView.RenderTransform><RotateTransform Angle="-7" CenterX="410" CenterY="250" /></views:OverlayView.RenderTransform></views:OverlayView></Viewbox><TextBlock Text="桌面模拟预览" FontSize="8" Foreground="{DynamicResource Legacy.867C96.Brush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" /></Grid></Border>
      <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="佩戴位置" FontSize="11" Foreground="{DynamicResource Legacy.ACA1BD.Brush}" /><Grid Margin="0,10,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions><Button Content="左手腕" Command="{Binding WristCommand}" CommandParameter="left" Padding="10,9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RightWrist}" Value="False"><Setter Property="Background" Value="{DynamicResource Legacy.6D5397.Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource Legacy.A98AD9.Brush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="2" Content="右手腕" Command="{Binding WristCommand}" CommandParameter="right" Padding="10,9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RightWrist}" Value="True"><Setter Property="Background" Value="{DynamicResource Legacy.6D5397.Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource Legacy.A98AD9.Brush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
        <DockPanel><TextBlock Text="面板大小" FontSize="11" Foreground="{DynamicResource Legacy.ACA1BD.Brush}" /><TextBlock Text="{Binding Scale, StringFormat={}{0:0}%}" FontSize="10" Foreground="{DynamicResource Legacy.B8A2D6.Brush}" HorizontalAlignment="Right" /></DockPanel><Slider Value="{Binding Scale, Mode=TwoWay}" Minimum="50" Maximum="160" Margin="-7,3,-7,8" /><DockPanel><TextBlock Text="不透明度" FontSize="11" Foreground="{DynamicResource Legacy.ACA1BD.Brush}" /><TextBlock Text="{Binding Opacity, StringFormat={}{0:0}%}" FontSize="10" Foreground="{DynamicResource Legacy.B8A2D6.Brush}" HorizontalAlignment="Right" /></DockPanel><Slider Value="{Binding Opacity, Mode=TwoWay}" Minimum="30" Maximum="100" Margin="-7,3,-7,5" /><CheckBox Content="抬腕时显示" IsChecked="{Binding RaiseToShow}" FontSize="11" /><CheckBox Content="启用手腕面板" IsChecked="{Binding OverlayEnabled}" FontSize="11" /></StackPanel>
      <Button Grid.Row="3" Content="更多面板设置  →" Command="{Binding PageCommand}" CommandParameter="wrist" Background="Transparent" FontSize="11" Foreground="{DynamicResource Legacy.B9A0DF.Brush}" BorderThickness="0" />
    </Grid></Border>
  </Grid>
</UserControl>
