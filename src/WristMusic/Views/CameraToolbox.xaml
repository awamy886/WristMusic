<UserControl x:Class="WristMusic.Views.CameraToolbox" x:Name="Toolbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid VerticalAlignment="Top">
    <WrapPanel x:Name="ToolList">
      <Button x:Name="Entry" Command="{Binding OpenTool, ElementName=Toolbox}" HorizontalAlignment="Left" Padding="18,12" Margin="0,0,16,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel><TextBlock Text="VRChat 相机录制" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Spout2 · MP4" Foreground="{DynamicResource Theme.Secondary}" FontSize="12" Margin="0,3,0,0" /></StackPanel>
        </StackPanel>
      </Button>
      <Button x:Name="MemoryEntry" Command="{Binding OpenMemory, ElementName=Toolbox}" Padding="18,12"
              MinWidth="{Binding ActualWidth, ElementName=Entry}" AutomationProperties.Name="内存优化">
        <StackPanel Orientation="Horizontal">
          <Path Width="20" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"
                Stroke="{Binding Foreground, ElementName=MemoryEntry}" StrokeThickness="1.4" StrokeLineJoin="Round"
                Data="M1,2 H23 V13 H1 Z M4,5 H8 V10 H4 Z M10,5 H14 V10 H10 Z M16,5 H20 V10 H16 Z M4,13 V16 M8,13 V16 M12,13 V16 M16,13 V16 M20,13 V16" />
          <StackPanel>
            <TextBlock Text="内存优化" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="标准优化 · 深度优化" Foreground="{DynamicResource Theme.Secondary}" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
      </Button>
    </WrapPanel>
    <StackPanel x:Name="MemoryPanel" Visibility="Collapsed" DataContext="{Binding MemoryTool}">
      <DockPanel Margin="0,0,0,10">
        <Button x:Name="MemoryBack" DockPanel.Dock="Right" Content="返回百宝箱" Command="{Binding CloseTool, ElementName=Toolbox}" Padding="12,5" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run Text="内存优化" FontSize="21" FontWeight="SemiBold" />
          <Run Text="(优化过程中会有略微卡顿)" FontSize="14" Foreground="{DynamicResource Theme.Secondary}" />
        </TextBlock>
      </DockPanel>
      <UniformGrid Columns="3" Margin="0,0,0,10">
        <StackPanel><TextBlock Text="总物理内存" Foreground="{DynamicResource Theme.Secondary}" /><TextBlock Text="{Binding Total}" FontSize="21" FontWeight="SemiBold" /></StackPanel>
        <StackPanel><TextBlock Text="当前已用内存" Foreground="{DynamicResource Theme.Secondary}" /><TextBlock Text="{Binding Used}" FontSize="21" FontWeight="SemiBold" /></StackPanel>
        <StackPanel><TextBlock Text="可用内存" Foreground="{DynamicResource Theme.Secondary}" /><TextBlock Text="{Binding Available}" FontSize="21" FontWeight="SemiBold" /></StackPanel>
      </UniformGrid>
      <UniformGrid Columns="2" Margin="0,0,0,8">
        <Button x:Name="StandardMode" Command="{Binding SelectMode}" CommandParameter="standard" HorizontalContentAlignment="Left" Padding="12,5" Margin="0,0,4,0">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Deep}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style></Button.Style>
          <StackPanel><TextBlock Text="标准优化" FontWeight="SemiBold" /><TextBlock Text="用户进程 · 工作集超过 200 MB" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" /></StackPanel>
        </Button>
        <Button x:Name="DeepMode" Command="{Binding SelectMode}" CommandParameter="deep" HorizontalContentAlignment="Left" Padding="12,5" Margin="4,0,0,0">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Deep}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style></Button.Style>
          <StackPanel><TextBlock Text="深度优化" FontWeight="SemiBold" /><TextBlock Text="用户进程 · 工作集 30 MB 及以上" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" /></StackPanel>
        </Button>
      </UniformGrid>
      <DockPanel Margin="0,0,0,6">
        <Button x:Name="OptimizeButton" Content="点击优化" Command="{Binding Optimize}" Padding="16,6" DockPanel.Dock="Left" Margin="0,0,12,0" />
        <StackPanel VerticalAlignment="Center">
          <DockPanel><TextBlock Text="{Binding Cooldown}" DockPanel.Dock="Right" Foreground="{DynamicResource Theme.Secondary}" /><TextBlock Text="{Binding Status}" FontWeight="SemiBold" /></DockPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6">
            <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track">
              <Border Background="{DynamicResource Theme.SurfaceSoft}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="3" />
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Theme.Accent}" CornerRadius="3" />
            </Grid></ControlTemplate></ProgressBar.Template>
          </ProgressBar>
        </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding Result}" TextWrapping="Wrap" LineHeight="20" ToolTip="释放量按系统可用物理内存的净增量估算；优化前后显示已用物理内存。" />
      <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Theme.Accent}" FontWeight="SemiBold" />
    </StackPanel>
    <StackPanel x:Name="Form" Visibility="Collapsed" DataContext="{Binding Recorder}">
      <DockPanel Margin="0,0,0,12">
        <Button Content="返回百宝箱" DockPanel.Dock="Right" Command="{Binding CloseTool, ElementName=Toolbox}" Padding="12,5" />
        <TextBlock Text="VRChat 相机录制" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
      <TextBlock Text="保存位置" FontSize="13" Foreground="{DynamicResource Theme.Secondary}" />
      <DockPanel Margin="0,3,0,10">
        <Button x:Name="FolderButton" Content="更改位置" DockPanel.Dock="Right" IsEnabled="{Binding CanConfigure}" Command="{Binding PickFolder, ElementName=Toolbox}" Padding="12,5" />
        <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,14,0" />
      </DockPanel>
      <Button Content="打开保存文件夹" ToolTip="在 Windows 文件资源管理器中打开录制目录"
              HorizontalAlignment="Left" Command="{Binding OpenFolder}" Padding="12,5" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <StackPanel Margin="0,0,16,0"><TextBlock Text="帧率" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,4" />
          <Button x:Name="RateButton" Content="{Binding FpsLabel}" Command="{Binding CycleFps}" Width="126" Padding="12,6" ToolTip="切换 30、60 或 120 FPS" /></StackPanel>
        <StackPanel><TextBlock Text="分辨率" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,4" />
          <Button x:Name="SizeButton" Content="{Binding SizeLabel}" Command="{Binding CycleSize}" Width="126" Padding="12,6" ToolTip="切换 720p、1080p 或 1440p" /></StackPanel>
      </StackPanel>
      <Button HorizontalAlignment="Left" MinWidth="126" Padding="14,8" Content="{Binding ButtonLabel}" Command="{Binding Toggle}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="相机预览（预览画面为30fps不代表真实输出）" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,0,4" />
          <Grid x:Name="PreviewBox" Width="320" Height="180" Background="#11151C" UseLayoutRounding="True">
            <Image Source="{Binding Preview.Image}" Stretch="Fill" IsHitTestVisible="False" />
            <TextBlock Text="{Binding Preview.Status}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
      <WrapPanel IsEnabled="{Binding CanConfigure}" Margin="0,8,0,0">
        <CheckBox x:Name="DesktopAudioSwitch" Content="录制桌面声音" IsChecked="{Binding RecordDesktopAudio}" Margin="0,2,18,2" ToolTip="录制 VRChat 以外的应用声音" />
        <CheckBox x:Name="MicAudioSwitch" Content="录制麦克风声音" IsChecked="{Binding RecordMicrophoneAudio}" Margin="0,2,18,2" ToolTip="使用 Windows 默认输入设备" />
        <CheckBox x:Name="GameAudioSwitch" Content="录制 VRChat 声音" IsChecked="{Binding RecordVrChatAudio}" Margin="0,2,0,2" />
      </WrapPanel>
      <TextBlock Text="{Binding Status}" Margin="0,10,0,0" Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" FontSize="13" MaxHeight="60" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel x:Name="FolderBrowser" Visibility="Collapsed">
      <DockPanel><Button DockPanel.Dock="Right" Content="取消" Command="{Binding CancelFolder, ElementName=Toolbox}" Padding="12,4" />
        <TextBlock Text="选择保存位置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
      <TextBlock x:Name="BrowserPath" Margin="0,6" TextTrimming="CharacterEllipsis" />
      <DockPanel Margin="0,0,0,6">
        <Button x:Name="ChooseHere" DockPanel.Dock="Right" Content="使用此文件夹" Command="{Binding AcceptFolder, ElementName=Toolbox}" Padding="12,4" />
        <Button x:Name="ParentFolder" HorizontalAlignment="Left" Content="上一级" Command="{Binding GoUp, ElementName=Toolbox}" Padding="12,4" />
      </DockPanel>
      <StackPanel x:Name="DirectoryRows" />
      <TextBlock x:Name="FolderMessage" Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,4">
        <Button x:Name="Prev" Content="上一页" Command="{Binding PageFolders, ElementName=Toolbox}" CommandParameter="-1" Padding="10,4" />
        <Button x:Name="Next" Content="下一页" Command="{Binding PageFolders, ElementName=Toolbox}" CommandParameter="1" Padding="10,4" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
