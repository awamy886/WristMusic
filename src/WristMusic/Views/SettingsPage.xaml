<UserControl x:Class="WristMusic.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource AppScrollViewer}" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="手动检测更新" Command="{Binding CheckUpdatesCommand}" Padding="14,8" />
          <CheckBox Content="自动更新" IsChecked="{Binding AutoUpdate}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="每小时检查一次 GitHub，后台下载新版本，下次启动时更新。" Foreground="{DynamicResource Theme.Secondary}" Margin="0,10,0,4" TextWrapping="Wrap" />
        <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource Theme.Accent}" FontSize="12" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="音乐软件" FontSize="17" FontWeight="SemiBold" />
        <CheckBox Content="关闭音乐软件时直接终止进程" IsChecked="{Binding ForceClosePlayer}" Margin="0,14,0,12" />
        <CheckBox Content="打开音乐软件时启动上次使用的播放器" IsChecked="{Binding OpenLastPlayer}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource Theme.AccentSoft}" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="默认使用明亮白色界面，开启深色模式后切换为深色紫色风格。" Foreground="{DynamicResource Theme.Secondary}" FontSize="12" Margin="0,10,20,0" TextWrapping="Wrap" /></StackPanel>
        <CheckBox Grid.Column="2" Content="深色模式" IsChecked="{Binding DarkMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="立即切换界面主题，并自动保存" />
      </Grid>
        </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="启动 SteamVR" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="默认关闭。关闭后，双击腕间音乐只会连接已运行的 SteamVR，不会启动它。开启后，下次打开腕间音乐时允许启动 SteamVR。" Foreground="{DynamicResource Theme.Secondary}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22" /></StackPanel>
        <CheckBox Grid.Column="1" Content="启动腕间音乐时启动 SteamVR" IsChecked="{Binding LaunchSteamVr, Mode=TwoWay}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="启动与运行" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="SteamVR 启动时自动运行腕间音乐，桌面窗口最小化到任务栏。" Foreground="{DynamicResource Theme.Secondary}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel>
        <CheckBox Grid.Column="1" Content="跟随 SteamVR 启动" IsChecked="{Binding FollowSteamVr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeSteamVrStartup}" VerticalAlignment="Center" ToolTip="由 SteamVR 启动腕间音乐" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SteamVrStartupStatus}" Foreground="{DynamicResource Theme.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,12" LineHeight="20" />
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
          <Button Content="重新检测" Command="{Binding RefreshSteamVrStartupCommand}" Padding="14,8" FontSize="11" />
          <Button Content="更新启动路径" Command="{Binding RepairSteamVrStartupCommand}" Visibility="{Binding NeedsSteamVrStartupRepair, Converter={StaticResource BoolVisibility}}" Padding="14,8" FontSize="11" Margin="10,0,0,0" />
        </StackPanel>
      </Grid>
    </Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="媒体控制与兼容" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="优先使用 Windows 系统媒体会话（SMTC），读取真实曲目信息并控制播放。&#x0a;没有媒体会话时，会尝试向所选播放器主窗口发送媒体命令。" Foreground="{DynamicResource Legacy.9B8EAA.Brush}" FontSize="12" TextWrapping="Wrap" LineHeight="25" Margin="0,12,0,10" /><CheckBox Content="允许全局媒体按键兼容" IsChecked="{Binding GlobalFallback}" /><TextBlock Text="仅在没有媒体会话且定向命令无法发送时使用。Windows 会选择接收应用，可能控制到其他播放器。兼容模式无法读取曲目信息或调整进度，也无法确认客户端是否执行。" Foreground="{DynamicResource Legacy.7E708E.Brush}" TextWrapping="Wrap" FontSize="11" Margin="54,0,0,6" LineHeight="21" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="VR 显示与手柄" FontSize="17" FontWeight="SemiBold" />
        <CheckBox Content="双击 B 显示 / 隐藏 VR 面板" IsChecked="{Binding DoubleBToOpen, Mode=TwoWay}" Margin="0,16,0,8" />
        <TextBlock Text="默认开启。双击手柄 B 键显示面板，再次双击隐藏；面板右上角也可手动隐藏。" Foreground="{DynamicResource Theme.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="54,0,0,12" />
        <CheckBox Content="仅在抬腕时显示" IsChecked="{Binding RaiseToShow, Mode=TwoWay}" />
        <TextBlock Text="默认关闭。开启后使用抬腕判断；双击 B 仍可直接显示面板。" Foreground="{DynamicResource Theme.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="54,0,0,0" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="网易云进度兼容（可选）" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{Binding NeteaseProgressStatus}" Foreground="{DynamicResource Theme.Accent}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding BridgeSetupStatus}" Foreground="{DynamicResource Theme.Secondary}" FontSize="11" Margin="0,10,0,16" TextWrapping="Wrap" LineHeight="21" />
        <StackPanel Orientation="Horizontal">
          <Button Content="安装进度插件" Command="{Binding InstallNeteaseBridgeCommand}" Padding="14,8" FontSize="11" />
          <Button Content="插件说明" Command="{Binding NeteaseBridgeGuideCommand}" Padding="14,8" FontSize="11" Margin="10,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SteamVR 连接" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding VrStatus}" Foreground="{DynamicResource Legacy.B79AFF.Brush}" Margin="0,12,0,0" /><TextBlock Text="{Binding VrDetail}" Foreground="{DynamicResource Legacy.8E809F.Brush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,20,0" LineHeight="21" /></StackPanel><Button Grid.Column="1" Content="重新连接 SteamVR" Command="{Binding ReconnectCommand}" VerticalAlignment="Center" /></Grid></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <DockPanel><CheckBox DockPanel.Dock="Right" Content="启用测试功能" IsChecked="{Binding ExperimentalFeaturesEnabled, Mode=TwoWay}" Margin="16,0,0,0" /><TextBlock Text="测试功能" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <TextBlock Text="默认关闭。可选择启用下方功能，设置自动保存。" Foreground="{DynamicResource Theme.Secondary}" FontSize="12" Margin="0,12,0,12" />
        <StackPanel IsEnabled="{Binding ExperimentalFeaturesEnabled}">
          <CheckBox Content="显示当前累计听歌时长" IsChecked="{Binding ShowListeningTime, Mode=TwoWay}" />
          <TextBlock Text="在桌面与 VR 原有音乐面板上显示累计听歌时长。仅统计开启此项后的实际播放时间，暂停不累计；切歌和跳转不会重复计时，关闭程序后保留。" Foreground="{DynamicResource Theme.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="54,2,0,12" LineHeight="21" />
          <TextBlock Text="{Binding ListeningTimeLabel}" Foreground="{DynamicResource Theme.Accent}" FontSize="16" Margin="54,0,0,0" Visibility="{Binding ListeningTimeVisible, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="关于腕间音乐" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="v3.5.0·星梦屿工作室" Foreground="{DynamicResource Theme.Accent}" FontSize="14" Margin="0,16,0,12" />
        <TextBlock Text="作者:awa星野厨のMY" Foreground="{DynamicResource Theme.Secondary}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBlock Text="交流群:1049685082" Foreground="{DynamicResource Theme.Secondary}" FontSize="13" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBlock Text="本程序完全免费·o(*≧▽≦)ツ┏━┓" Foreground="{DynamicResource Theme.Secondary}" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel></ScrollViewer>
</UserControl>
