<UserControl x:Class="WristMusic.Views.LightPlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WristMusic.Views">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="16" /><RowDefinition Height="86" /></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="26,22">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /><RowDefinition Height="52" /><RowDefinition Height="82" /><RowDefinition Height="58" /><RowDefinition Height="24" /></Grid.RowDefinitions>
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Theme.Accent}" Margin="0,0,10,0" /><TextBlock Text="播放控制" FontSize="16" FontWeight="SemiBold" /></StackPanel>
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" HorizontalAlignment="Right" Width="176" Height="34" FontSize="12" ToolTip="选择音乐来源" />
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource Theme.SurfaceSoft}" CornerRadius="16" Padding="20" Margin="0,14,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Width="156" Height="156" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="16" Background="{DynamicResource Theme.Surface}">
                <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.08" Color="#356FF3" /></Border.Effect>
                <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="音乐来源" Foreground="{DynamicResource Theme.Muted}" FontSize="11" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="13" Foreground="{DynamicResource Theme.Secondary}" Margin="0,8,0,16" TextTrimming="CharacterEllipsis" />
                <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" MaxWidth="260">
                  <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="{DynamicResource Theme.Secondary}" TextTrimming="CharacterEllipsis" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions>
            <Slider x:Name="Progress" Value="{Binding SeekPosition, Mode=TwoWay}" Minimum="{Binding TimelineMin}" Maximum="{Binding Duration}" IsEnabled="{Binding CanSeek}" ToolTip="拖动调整播放进度" />
            <TextBlock Grid.Row="1" Text="{Binding PositionLabel}" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Margin="7,2,0,0" />
            <TextBlock Grid.Row="1" Text="{Binding DurationLabel}" FontSize="11" Foreground="{DynamicResource Theme.Muted}" Margin="0,2,7,0" HorizontalAlignment="Right" />
          </Grid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding MediaCommand}" CommandParameter="previous" ToolTip="上一首" Width="50" Height="50" Margin="0,0,22,0" />
            <Button Content="{Binding PlayGlyph}" Command="{Binding MediaCommand}" CommandParameter="toggle" ToolTip="{Binding PlayLabel}" Width="70" Height="70" Padding="0" FontFamily="Segoe MDL2 Assets" FontSize="27" Background="{DynamicResource Theme.Accent}" Foreground="{DynamicResource Theme.OnAccent}" BorderThickness="0">
              <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Disc" CornerRadius="35" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="{DynamicResource Theme.PrimaryHover}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Disc" Property="Opacity" Value="0.35" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="BorderBrush" Value="{DynamicResource Theme.Text}" /><Setter TargetName="Disc" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding MediaCommand}" CommandParameter="next" ToolTip="下一首" Width="50" Height="50" Margin="22,0,0,0" />
            
          </StackPanel>
          <Border Grid.Row="4" Background="{DynamicResource Theme.SurfaceSoft}" CornerRadius="12" Padding="14,0" Margin="0,6,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Theme.Secondary}" Margin="0,0,10,0" /><TextBlock Text="系统音量" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" /></StackPanel>
              <Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding CanVolume}" ToolTip="Windows 默认输出设备的主音量" />
              <TextBlock Grid.Column="2" Text="{Binding VolumeLabel}" FontSize="12" Foreground="{DynamicResource Theme.Secondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <DockPanel Grid.Row="5" VerticalAlignment="Bottom"><TextBlock DockPanel.Dock="Right" Text="{Binding ListeningTimeLabel}" Visibility="{Binding ListeningTimeVisible, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource Theme.Accent}" FontSize="10" Margin="12,0,0,0" /><TextBlock Text="{Binding CapabilityLabel}" Foreground="{DynamicResource Theme.Muted}" FontSize="10" TextTrimming="CharacterEllipsis" /></DockPanel>
        </Grid>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="142" /><ColumnDefinition Width="10" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="桌面播放器" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding ModeLabel}" FontSize="10" Foreground="{DynamicResource Theme.Muted}" Margin="0,6,0,0" /></StackPanel>
          <Button Grid.Column="1" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" Padding="12,11" Content="打开音乐软件" VerticalAlignment="Center" />
          <Button Grid.Column="3" Command="{Binding CloseCommand}" Padding="12,11" Content="关闭软件" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="260" /><RowDefinition Height="16" /><RowDefinition /></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition /><RowDefinition Height="46" /></Grid.RowDefinitions>
          <TextBlock Text="手腕控制" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="VR" FontSize="10" Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Right" Margin="0,5,0,0" />
          <Border Grid.Row="1" Background="{DynamicResource Theme.SurfaceSoft}" CornerRadius="12" Margin="0,10,0,10"><Viewbox Margin="10" IsHitTestVisible="False"><views:OverlayView /></Viewbox></Border>
          <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="{Binding VrStatus}" FontSize="11" Foreground="{DynamicResource Theme.Accent}" /><TextBlock Text="{Binding VrDetail}" Foreground="{DynamicResource Theme.Muted}" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition /><RowDefinition Height="30" /></Grid.RowDefinitions>
          <TextBlock Text="面板设置" FontSize="16" FontWeight="SemiBold" />
          <StackPanel Grid.Row="1">
            <Grid Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button Content="左手腕" Command="{Binding WristCommand}" CommandParameter="left" Padding="10,9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RightWrist}" Value="False"><Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Grid.Column="2" Content="右手腕" Command="{Binding WristCommand}" CommandParameter="right" Padding="10,9"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding RightWrist}" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" /><Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </Grid>
            <DockPanel><TextBlock Text="面板大小" FontSize="11" Foreground="{DynamicResource Theme.Secondary}" /><TextBlock Text="{Binding Scale, StringFormat={}{0:0}%}" FontSize="11" Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Right" /></DockPanel>
            <Slider Value="{Binding Scale, Mode=TwoWay}" Minimum="50" Maximum="160" Margin="-7,2,-7,6" />
            <DockPanel><TextBlock Text="不透明度" FontSize="11" Foreground="{DynamicResource Theme.Secondary}" /><TextBlock Text="{Binding Opacity, StringFormat={}{0:0}%}" FontSize="11" Foreground="{DynamicResource Theme.Accent}" HorizontalAlignment="Right" /></DockPanel>
            <Slider Value="{Binding Opacity, Mode=TwoWay}" Minimum="30" Maximum="100" Margin="-7,2,-7,2" />
            <CheckBox Content="抬腕时显示" IsChecked="{Binding RaiseToShow}" FontSize="11" Margin="0,8" />
            <CheckBox Content="启用手腕面板" IsChecked="{Binding OverlayEnabled}" FontSize="11" Margin="0,8" />
          </StackPanel>
          <Button Grid.Row="2" Content="更多面板设置  →" Command="{Binding PageCommand}" CommandParameter="wrist" Background="Transparent" Foreground="{DynamicResource Theme.Accent}" BorderThickness="0" Padding="4" FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
