<UserControl x:Class="WristMusic.Views.AppsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><Border Background="{DynamicResource Legacy.241E30.Brush}" CornerRadius="12" Padding="18,14" BorderBrush="{DynamicResource Legacy.3C304F.Brush}" BorderThickness="1" Margin="0,0,0,18"><TextBlock Text="首次使用：选择音乐软件的主程序，在客户端开启「系统媒体控制 / SMTC」（如果提供），播放歌曲后返回正在播放。不同版本的客户端可用能力会有差异。" Foreground="{DynamicResource Legacy.BDB0D2.Brush}" FontSize="12" TextWrapping="Wrap" /></Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Players.Apps}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Background="{Binding Color}" CornerRadius="14" Width="48" Height="48" VerticalAlignment="Center"><TextBlock Text="{Binding Mark}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Legacy.15151C.Brush}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource Legacy.9B8CAE.Brush}" FontSize="10" Margin="13,5,0,0" /></StackPanel><TextBlock Text="{Binding PathLabel}" Foreground="{DynamicResource Legacy.71697F.Brush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" ToolTip="{Binding ExePath}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="选择程序" Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="14,10" FontSize="11" /><Button Content="打开" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="15,10" FontSize="11" Margin="8,0,0,0" /><Button Content="关闭" Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="15,10" FontSize="11" Margin="8,0,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
</UserControl>
