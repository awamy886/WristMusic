<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WristMusic</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>6.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <Description>腕间音乐 · SteamVR 桌面音乐控制</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Update="ThirdParty/WristCamera.exe" TargetPath="WristCamera.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/Spout2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ThirdParty/openvr_api.dll" TargetPath="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdParty/OpenVR-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/app.ico" />
    <EmbeddedResource Include="ReleaseNotes.$(Version).local.txt" Condition="Exists('ReleaseNotes.$(Version).local.txt')" LogicalName="WristMusic.LocalReleaseNotes" WithCulture="false" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)$(Configuration)\helper\WristUpdater.exe" LogicalName="WristMusic.UpdaterExe" />
    <None Update="Input/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>
  <Target Name="BuildUpdateHelper" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\..\Updater\Program.cs"
          Outputs="$(BaseIntermediateOutputPath)$(Configuration)\helper\WristUpdater.exe">
    <MakeDir Directories="$(BaseIntermediateOutputPath)$(Configuration)\helper" />
    <Exec Command="&quot;$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /optimize+ /codepage:65001 /reference:System.IO.Compression.dll /out:&quot;$(BaseIntermediateOutputPath)$(Configuration)\helper\WristUpdater.exe&quot; &quot;$(MSBuildProjectDirectory)\..\Updater\Program.cs&quot;" />
  </Target>
</Project>
